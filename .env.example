# Kopiere diese Datei nach .env und trage lokale Schlüssel ein. .env wird nie committet.

# Duffel Testmodus (muss mit duffel_test_ beginnen). Leer = klar markierte Demo-Flüge.
DUFFEL_ACCESS_TOKEN=

# Optional: echte Hotels über Nuitée/LiteAPI (Sandbox-Key beginnt mit sand_). Aktiv mit `npm run start:hotels`
# (oder HOTELS_PROVIDER=liteapi hier setzen).
LITEAPI_KEY=
# HOTELS_PROVIDER=liteapi

# Optional: KI-Agent (Claude) – in der Regie umschaltbar. TREVL_LLM=on lässt Claude zusätzlich beim Übersetzen helfen.
# TREVL_LLM=on
ANTHROPIC_API_KEY=

# Ports. HOST=0.0.0.0 macht die App im WLAN erreichbar (z. B. auf dem echten Handy).
HOST=127.0.0.1
PORT=4310
LEASH_PORT=4311

# Optional: externe Leash-Engine statt der eingebauten (z. B. auf einem anderen Server).
# LEASH_URL=http://127.0.0.1:4311
# LEASH_CUSTOMER_KEY=
# LEASH_AGENT_KEY=
