{
  "name": "trevl",
  "version": "1.0.0",
  "private": true,
  "description": "trevl – Reiseagent an der Leine (Agent on a Leash, Swiss AI Weeks 2026)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/main.js",
    "start:hotels": "node server/main.js --port=4320 --leash-port=4321 --data-dir=data-hotels --hotels=liteapi",
    "leash": "node server/leash/main.js",
    "build:jev": "node scripts/build-jev.mjs",
    "test": "node scripts/build-jev.mjs --check && node --test",
    "test:jev:live": "node scripts/jev-live.mjs",
    "smoke": "node scripts/smoke.mjs",
    "viseca-replay": "node scripts/viseca-replay.mjs ref/data"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
